# Optional model enhancement only: default compression uses deterministic rules.
# CCR does not auto-load .env files. Export these variables in your shell.
# API credential for the optional HTTP scorer; leave blank to test safe downgrade.
CCR_LLM_API_KEY=
# Public model identifier; recorded in proofs as llm:<model>.
CCR_LLM_MODEL=gpt-4o-mini
# OpenAI-compatible API root. No credential, query, or fragment is permitted here.
CCR_LLM_BASE_URL=https://api.openai.com/v1
# Positive HTTP timeout in seconds; network errors automatically fall back to rules.
CCR_LLM_TIMEOUT=5
